flowchart TB
    P0["$$\begin{gathered}\text{① 起点：prefill 这一段的形状是「每轮都不一样」的}\\\\\text{prompt 长度任意：这轮 }32\text{、下轮 }2048\text{，没有档位可以补}\\\\\text{批内长度各异：一条 }100\text{、一条 }400\text{，还要紧凑打包}\\\\\text{前缀命中时分两段：首段 }L_Q=L_K\text{，续段两者不等}\\\\\text{⚠ 图要求形状写死，而这里三个自由度同时在变}\\\\\text{⇒ 直接把 prefill 录成一张图，从根上就做不到}\end{gathered}$$"]

    subgraph NAIVE["走过的一条弯路：把注意力摘出图外，其余部分录图（分段图）"]
        direction TB
        N1["$$\begin{gathered}\text{思路：变的那一小块（注意力）留在图外逐算子跑}\\\\\text{不变的一大块（投影、归一化、激活）录进图里}\\\\\text{听上去两全其美 —— 实测两项都变差了}\end{gathered}$$"]
        N2["$$\begin{gathered}\text{缺陷一：静态缓冲的搬运反而更多}\\\\\text{图要求输入输出都在固定地址上}\\\\\text{每次进出图都要搬一趟，而「进图 / 出图」发生了很多次}\\\\\text{拷贝次数：逐算子 }168\ \to\ \text{分段图 }267\quad(+59\%)\\\\\text{本来想省提交，结果先多付了一笔搬运}\end{gathered}$$"]
        N3["$$\begin{gathered}\text{缺陷二：内核总数不降反升}\\\\\text{注意力摘出去后，图内图外各走一遍自己的内核序列}\\\\\text{内核总数：逐算子 }646\ \to\ \text{分段图 }784\quad(+21\%)\\\\\text{⚠ 两个缺陷同向：它是唯一「两项都变差」的方案}\\\\\text{结论：这个方向被放弃了}\end{gathered}$$"]
    end

    P1["$$\begin{gathered}\text{② 换一条路：不录图，改成「把整段代码编译成更少的内核」}\\\\\text{区别在消掉的东西不同 —— 这是最容易说混的一点}\\\\\text{录图：消掉【提交次数】（内核个数不变，中间结果照样落显存）}\\\\\text{编译：消掉【内核个数】（把多个逐元素操作融成一个）}\\\\\text{⇒ 两者不冲突，解决的是两笔不同的账，可以叠加}\\\\\text{⚠ 面试里说「编译会把多个内核融合成一个」是对的}\\\\\text{但说「录图会把多个内核融合成一个」就是错的}\end{gathered}$$"]

    subgraph DYN["编译器的两段式：前端负责「看得见」，后端负责「改得动」"]
        direction TB
        D1["$$\begin{gathered}\text{前端（逐行执行 Python，把算子记成一张图）}\\\\\text{它不跑算子，只是「边执行边记账」}\\\\\text{遇到不认识的调用 ⇒ 断图，切断处退回逐算子执行}\\\\\text{⚠ 断图的代价是三笔：段间失去融合机会、中间结果落回显存、CPU 重新介入}\\\\\text{⇒ 一张大图被切成很多小段，编译的收益基本就没了}\end{gathered}$$"]
        D2["$$\begin{gathered}\text{后端（拿到前端的图，改写并生成内核）}\\\\\text{它才是真正做融合、算子选择、自动调优的那一方}\\\\\text{⚠ 面试里说「编译会融合算子」时，别把功劳记到前端头上}\\\\\text{前端只负责「看得见」，改图与生成内核是后端的活}\end{gathered}$$"]
    end

    subgraph OP["断图从哪来：五个必须包成黑盒算子的地方"]
        direction TB
        O1["$$\begin{gathered}\text{为什么这些必须包：它们内部有【数据相关的分支】}\\\\\text{例：注意力里有「是不是 prefill」这种分支}\\\\\text{前端追踪时只能按其中一条路走，另一条路它看不见}\\\\\text{⇒ 只能断图。解法：把整块注册成一个不透明算子}\\\\\text{编译期把它当黑盒，不试图展开内部、也不跨边界融合}\\\\\text{换来的是：图保持完整 ＋ 切分点明确}\\\\\text{代价是算子内部的 Python 代码不会被优化}\\\\\text{—— 但真正的加速来自里面调用的手写 CUDA 内核}\end{gathered}$$"]
        O2["$$\begin{gathered}\text{五个黑盒算子（前四个在同一个文件，第五个单独放）}\\\\\text{① 注意力【最大的那个断图源，只数前四个就漏了它】}\\\\\text{② 归一化 ③ 残差融合归一化 ④ 激活与门控 ⑤ 旋转位置编码}\\\\\text{⚠ 漏掉①，整条因果链就断了：}\\\\\text{「注意力里有分支 → 必须包成黑盒 → 所以才要写形状推导 →}\\\\\text{所以缓存才要走全局上下文」}\end{gathered}$$"]
        O3["$$\begin{gathered}\text{形状推导函数：没有它编译直接失败}\\\\\text{编译追踪时不跑真实内核，只调这个函数问「输出什么形状」}\\\\\text{签名：吃同样的参数，返回一个空张量，形状与真实输出一致}\\\\\text{⚠ 两边形状不一致的后果：编译推出错误形状}\\\\\text{而报错位置往往离这里很远 —— 排查成本极高}\end{gathered}$$"]
        O4["$$\begin{gathered}\text{副作用声明：这一条不写会得到一个【空图】}\\\\\text{有个归一化算子是原地改写的（两个输入张量都被它改）}\\\\\text{若声明「无副作用」，编译会认为输出是新张量}\\\\\text{别名推断随之出错，与图实际写入的显存冲突}\\\\\text{实测后果：带图模式捕获出一张空图，prefill 性能暴跌}\\\\\text{正确做法：声明「我改这两个参数」⇒ 编译期作为黑盒处理}\\\\\text{⚠ 同一函数在调用处【不能写成赋值形式】}\\\\\text{那会丢掉原地写入的结果 —— 看起来还能跑，只是数值不对}\end{gathered}$$"]
        O5["$$\begin{gathered}\text{另一个开关：必须关掉「提前启动下一个内核」}\\\\\text{这个特性让下一个内核不等前一个结束就开始准备}\\\\\text{⚠ 它打乱显式依赖关系 —— 而录图与编译正是「提前固化依赖」的场景}\\\\\text{⇒ 五个算子全部显式关掉它}\end{gathered}$$"]
    end

    subgraph FUSE["融合到底省了什么：访存账（这是编译唯一真正的收益来源）"]
        direction TB
        U1["$$\begin{gathered}\text{朴素的归一化被拆成 }k\approx 7\text{ 个内核}\\\\\text{转换精度 / 平方 / 求均值 / 加 }\epsilon\text{ 取倒数平方根 / 乘 / 乘权重 / 转回精度}\\\\\text{每个内核都要：从显存读一遍 → 在片上算 → 写回显存}\\\\\text{中间张量一个都不留，纯粹是「读进来又写出去」}\end{gathered}$$"]
        U2["$$\begin{gathered}\text{单层的往返流量}\\\\B_{\text{norm}}=k\cdot\underbrace{2}_{\text{读一次}+\text{写一次}}\cdot H\cdot b\\\\H\cdot b=1024\times 2\,\mathrm{B}=2\ \mathrm{KiB}\ \Rightarrow\ B_{\text{norm}}=7\times 2\times 2\ \mathrm{KiB}=28\ \mathrm{KiB}\\\\\text{全部层：}L\cdot B_{\text{norm}}=28\times 28\ \mathrm{KiB}\approx 784\ \mathrm{KiB}\\\\\text{再乘上序列长度：}B_{\text{total}}=L\cdot S\cdot B_{\text{norm}}=28\times 2048\times 28\ \mathrm{KiB}\approx 1.5\ \mathrm{GiB}\\\\\text{⚠ 这是【中间张量的总往返流量】，不是【显存占用】}\\\\\text{把「流量」说成「占用」是这道题最常见的口径错误}\\\\\text{融合后：}k\text{ 个内核变 }1\text{ 个 ⇒ 读一次、片上算完、写回一次}\end{gathered}$$"]
    end

    subgraph HALF["半编译策略：为什么只有首段能进编译图"]
        direction TB
        G1["$$\begin{gathered}\text{编译图只覆盖「没有命中前缀」的那一段（首段）}\\\\\text{续段走逐算子 ＋ 分页注意力}\\\\\text{两者作用于不同的段，互不冲突}\\\\\text{⚠ 关键前提：批内【所有】请求都必须没有命中前缀}\\\\\text{只要有一个带着缓存，整批都退回逐算子}\end{gathered}$$"]
        G2["$$\begin{gathered}\text{续段为什么不进图：两个理由}\\\\\text{① 它带着页表、以及「查询长度与键长度不等」这组参数}\\\\\text{而编译图的签名是固定的纯张量列表，对不上}\\\\\text{② 续段的省算收益来自分页注意力本身}\\\\\text{（键值已缓存，注意力直接读缓存页、跳过重复计算与写入）}\\\\\text{⇒ 这份收益与编译无关，编译不编译都省}\end{gathered}$$"]
    end

    subgraph BUILD["启动期：编译与热身（在引擎初始化时做完）"]
        direction TB
        I1["$$\begin{gathered}\text{用占位输入触发一次编译，对首个请求零影响}\\\\\text{假输入：token 号 }1\dots n\text{、位置 }0\dots n-1\text{、前缀和 }[0,n]\text{、槽位 }0\dots n-1\\\\n=\min(256,\ \text{上下文上限})\\\\\text{⚠ 首次编译要几十秒（无缓存），磁盘缓存命中后约十秒}\\\\\text{⇒ 必须放在初始化阶段，放到推理期就是一次巨大卡顿}\end{gathered}$$"]
        I2["$$\begin{gathered}\text{ 热身完必须把缓存清零 —— 漏了会静默错乱}\\\text{热身真的往键值缓存里写了东西（假 token 也是 token）}\\\text{不清零 ⇒ 后续请求的注意力把热身数据当成「前文」读进去}\\\text{表现：输出错乱，但不报错、不崩}\\\text{⚠ 这是「热身」这件事最容易漏的一步}\end{gathered}$$"]
        I3["$$\begin{gathered}\text{编译模式怎么选（含张量并行时自动换挡）}\\\\\text{单卡或纯流水并行：用用户指定的模式}\\\\\text{含张量并行：自动换成「只调优、不套图」的模式}\\\\\text{⚠ 原因：编译自带的图后端会和集合通信打架}\\\\\text{⇒ 这是本项目里「两套图不能共存」的唯一一处}\end{gathered}$$"]
        I4["$$\begin{gathered}\text{动态形状：一次编译覆盖任意长度}\\\\\text{开：符号形状，编译一次管所有长度（数值上略保守）}\\\\\text{关：形状写死，重放更快；但每个新长度都要重编译 }\sim 2\sim 12\ \mathrm{s}\\\\\text{判据：在线服务（长度随时在变）必须开；离线固定长度可以关}\end{gathered}$$"]
    end

    subgraph RUN["运行期：一个 prefill 请求进来，走哪条路"]
        direction TB
        Q1["$$\begin{gathered}\text{判据（两个条件同时成立才走编译图）}\\\\\text{① 编译图已经建好了（开关打开且初始化成功）}\\\\\text{② 批内所有请求的已缓存长度都等于 }0\\\\\text{否则退回逐算子路径 —— 与图路径必须算出完全一致的结果}\end{gathered}$$"]
        Q2["$$\begin{gathered}\text{编译图只收五样东西（签名固定，不能多也不能少）}\\\\\text{token 号 / 位置 / 槽位表 / 变长前缀和 / 最长查询长度}\\\\\text{⚠ 没有页表、也没有「查询长度与键长度不等」那组参数}\\\\\text{—— 这正是它只能覆盖首段的原因}\\\\\text{流水并行时再多收一项：上一段传来的隐层与残差}\end{gathered}$$"]
        Q3["$$\begin{gathered}\text{出口与采样【刻意留在图外】}\\\\\text{① 出 logits 的形状取决于批里有多少条请求}\\\\\text{② 采样带随机性、还要按「贪心 / 采样」走不同分支}\\\\\text{⇒ 放进图里会逼着编译器反复重编译}\\\\\text{⚠ 分支必须在图外决定 —— 图里的分支在重放时会走错}\end{gathered}$$"]
        Q4["$$\begin{gathered}\text{prefill 的账本推进与出口取位}\\\\\text{账本：整段一起推进（不是 }1\text{ 个）}\\\\\text{出口：每条序列只取【最后 }1\text{ 个位置】的隐层去出 logits}\\\\\text{位置由变长前缀和算出来：}\mathrm{last}=\mathrm{cu}[1{:}b{+}1]-1\\\\\text{⚠ 中间那些位置的隐层算出来了但没人要 —— 这是 prefill 的固有浪费}\end{gathered}$$"]
    end

    subgraph MEAS["实测：编译到底值多少（每一项都带口径）"]
        direction TB
        M1["$$\begin{gathered}\text{M1 短 prompt 收益最大，长 prompt 收敛到算力边界}\\\\\text{口径：单张 RTX 4090D，Qwen3-0.6B，单请求，两边都开 decode 图}\\\\\text{只隔离「编译」这一项}\\\\L=32:\ 16.47\to 2.77\ \mathrm{ms}\ (5.94\times)\\\\L=128:\ 16.23\to 3.20\ (5.08\times)\qquad L=512:\ 15.97\to 6.40\ (2.49\times)\\\\L=1024:\ 15.79\to 12.00\ (1.32\times)\qquad L=2048:\ 22.94\to 22.25\ (1.03\times)\\\\\text{⚠ 2048 时两条线交汇 —— 短序列是「提交受限」，长序列是「算力受限」}\end{gathered}$$"]
        M2["$$\begin{gathered}\text{M2 交汇的机制：两条线的斜率不一样}\\\\T(L)=T_{\text{launch}}+\kappa\cdot L\\\\\text{逐算子：}\kappa=6.47/2016=3.21\ \mu s/\text{token}\\\\\text{编译后：}\kappa=19.48/2016=9.66\ \mu s/\text{token}\\\\\text{⚠ 编译后的斜率是逐算子的 }3\text{ 倍}\\\\\text{机制：融合后单个内核更大、寄存器占用更高}\\\\\text{⇒ 长序列下每 token 成本并不比一堆小内核便宜}\\\\\text{一个「截距大、斜率小」，一个「截距小、斜率大」}\\\\\text{⇒ 两条线必然在某处相交，交点就是收益归零的地方}\end{gathered}$$"]
        M3["$$\begin{gathered}\text{M3 内核数与拷贝数的实测变化}\\\\\text{逐算子：}646\text{ 个内核},\ 168\text{ 次拷贝}\\\\\text{编译后：}537\text{ 个内核}\ (-109),\ 116\text{ 次拷贝}\ (-52)\\\\\text{对比那条弯路（分段图）：}784\text{ 个内核},\ 267\text{ 次拷贝}\\\\\text{⇒ 编译是唯一「两项都变好」的方案}\end{gathered}$$"]
        M4["$$\begin{gathered}\text{M4 数值正确性：融合会改变舍入，但不会改变结果}\\\\\text{最大绝对误差 }|\Delta|_{\max}=1.125\text{（bf16 下正常量级）}\\\\\text{贪心逐 token 一致率 }55/63=87.3\%\\\\\text{分叉全部是「前两名分数接近」时的翻转，无系统性偏差}\\\\\text{⚠ 引擎里强制关掉了 bf16 的降精度归约}\end{gathered}$$"]
    end

    subgraph PIT["已知的坑（每条都给现象 → 定位 → 面试角度）"]
        direction TB
        T1["$$\begin{gathered}\text{T1 给采样器加编译装饰器 ⇒ 吞吐掉到三分之一}\\\\\text{现象：}T\gt 0\text{ 时吞吐 }2957.5\to 1001\ \text{token/s}\\\\\text{机制：连续批处理下并发数随请求完成而递减}\\\\\text{（}16\to 13\to 8\text{），每来一个新并发数就重编译一次}\\\\\text{秒级编译开销直接算进稳态吞吐}\\\\\text{定位：把装饰器去掉，吞吐立刻回来}\\\\\text{面试角度：编译按形状特化 —— 【动态形状的代码不要盲目上编译】}\end{gathered}$$"]
        T2["$$\begin{gathered}\text{T2 副作用声明漏写 ⇒ 捕获出一张空图}\\\\\text{现象：带图模式 prefill 性能暴跌（图是空的）}\\\\\text{定位：看捕获出来的图里有多少节点}\\\\\text{面试角度：不透明的黑盒算子必须把「我改了哪些参数」讲清楚}\end{gathered}$$"]
        T3["$$\begin{gathered}\text{T3 热身污染了键值缓存 ⇒ 输出静默错乱}\\\\\text{现象：能跑、不报错，但第一批请求的输出不对}\\\\\text{定位：热身之后、接客之前把缓存清零，问题消失}\\\\\text{面试角度：任何「用假数据预热」的代码，都要问一句「假数据留在哪了」}\end{gathered}$$"]
        T4["$$\begin{gathered}\text{T4 把数据相关的分支放进图里 ⇒ 重放时走错路}\\\\\text{现象：开图与关图结果不一致，且只在某些输入上出现}\\\\\text{定位：逐 token 比两条路径的输出}\\\\\text{面试角度：图是「提前固化」的，凡是依赖【数据内容】的分支都必须留在图外}\end{gathered}$$"]
        T5["$$\begin{gathered}\text{T5 长序列下收益归零（不是 bug，是机制）}\\\\\text{现象：}L=2048\text{ 时编译前后几乎一样（}1.03\times\text{）}\\\\\text{定位：按斜率反解，编译后的每 token 成本更高}\\\\\text{面试角度：编译优化的是「提交」，不是「算力」}\\\\\text{长序列已经算力受限 ⇒ 拿它没办法，这是物理边界}\end{gathered}$$"]
    end

    E2["$$\begin{gathered}\text{⑨ 一句话收束}\\\\\text{decode 走录图：把「每步提交 }2500\text{ 次」变成「提交 }1\text{ 次」}\\\\\text{prefill 走编译：把「}7\text{ 个内核做一件事」变成「}1\text{ 个内核做完」}\\\\\text{两者消的是两笔不同的账 ⇒ 可以叠加（}9.1\times\text{ 与 }1.01\times\text{ 各管一列）}\\\\\text{共同点：都在消 CPU 侧的固定开销，都动不了「算力」这个物理边界}\\\\\text{所以模型越大、序列越长，两者的相对收益都越小}\end{gathered}$$"]

