flowchart TB
    HOST["$$\begin{gathered}\text{① 引擎层（CPU）：跑在进程 0 · 卡 0 上 = driver}\\\\\text{（这一段不在任何 GPU 上，归到卡 0 只是为了标出它跑在哪）}\\\\\text{调度：先挑 decode（老请求各 1 个 token），再挑 prefill（新请求整段）}\\\\\text{顺手做的事：显存预检（按 }K+1\text{ 个位置算）、挑要抢占的序列、判前缀缓存命中}\\\\\text{开着投机：decode 请求先下到 ⑰ 上半场出草稿}\\\\\text{关着投机：直接下去组表 —— 那就是普通 decode}\\\\\text{本图画的是 TP=2 }\times\text{ PP=2 的四卡；DP 与 EP 两个轴见「说明区」}\end{gathered}$$"]

    subgraph SP1["⑰ 投机解码 · 上半场（CPU · 卡 0）：先算划不划算，再出草稿、占账本"]
        direction TB
        S0["$$\begin{gathered}\text{⑰-0 为什么值得做：decode 的瓶颈是「每步把全部权重读一遍」}\\\\\text{本机实测：0.6B 每步约 }1.19\text{ ms，而算一遍只要 }0.0036\text{ ms ⇒ 是访存瓶颈}\\\\\text{每产出 token 的时间}=\frac{T_{\text{读权重}}+T_{\text{线性层}}+T_{\text{注意力}}}{1+\text{接受的草稿数}}\\\\\text{分母变大、分子几乎不变 —— 这就是全部收益来源}\\\\E[\text{新 token 数}]=1+\alpha+\alpha^{2}+\dots+\alpha^{K}=\frac{1-\alpha^{K+1}}{1-\alpha}\\\\\text{⚠ }\alpha\text{ 完全由文本重复度决定：高重复 }5.87\times\text{、代码 }1.16\times\\\\\text{所以投机不是万灵药：它买的是「输入本身有冗余」这件事}\end{gathered}$$"]
        S1["$$\begin{gathered}\text{⑰-1 草稿从哪来（两条路，本项目两条都实现了）}\\\\\text{n-gram：拿末尾几个 token 去历史里查表，命中就抄后面的}\\\\\text{⇒ 它根本不跑模型，所以既没有草稿 KV，也拿不出草稿概率}\\\\\text{draft 模型：同词表的小模型自回归跑 }K\text{ 步 ⇒ 有一套自己独立的 KV}\\\\\text{建议先跑 n-gram：不依赖第二个模型，能立刻验出账本与采样的错}\\\\\text{草稿返空（没匹配上）⇒ 这一轮退回普通 decode，与「全被拒」是两件事}\end{gathered}$$"]
        S2["$$\begin{gathered}\text{⑰-2 构造验证输入：}\big[\text{最后一个 token},\ \text{草稿}_1,\dots,\text{草稿}_K\big]\\\\\text{共 }K+1\text{ 个位置 —— 为什么要把最后一个 token 重复一遍？}\\\\\text{这样输出位置 }i\text{ 就直接对应「草稿 }i\text{ 该不该接受」}\\\\\text{不必额外保存上一步的 logits；代价是多算一个位置}\\\\\text{定宽补齐：同一批里各序列的草稿长度取最大那个，空位填 }-1\\\\\text{（填 }-1\text{ 不等于任何真实 token，贪心判定会自然停下）}\end{gathered}$$"]
        S3["$$\begin{gathered}\text{⑰-3 按 }K+1\text{ 个位置在 KV 账本里占槽（不是 }K\text{ 个）}\\\\\text{因为验证阶段这 }K+1\text{ 个位置的 KV 全部会算出来并写进去}\\\\\text{⚠ 若「已缓存数 }\bmod 256」+K+1>256\text{ 就会跨块 ⇒ 必须提前多要一个块}\\\\\text{不多要的后果：挤掉别的序列，或者写到没分配过的槽上}\\\\\text{一次前向能让 }K+1\text{ 个位置并存，靠的是因果掩码}\\\\\text{位置 }i\text{ 只看 }i\text{ 及以前 ⇒ 和自回归逐个喂逐位相同（这点与 beam search 不同）}\end{gathered}$$"]
    end

    H1["$$\begin{gathered}\text{交接① 组表与搬运（CPU}\to\text{GPU；拷完立刻返回，不在这里等）}\\\\\text{6 张表：本步 token 号 / 位置 / 物理槽位 / 每序列已缓存长度 / 变长前缀和 / 块表}\\\\\text{从 pinned 内存异步拷进显存 —— 用 pinned 是为了省掉一次中转拷贝}\\\\\text{为什么必须有这条边界：CPU 决定「算谁」、GPU 决定「算出什么」}\\\\\text{CPU 的活（调度 / 组表 / 账本）与 GPU 的前向严格交替、不重叠}\end{gathered}$$"]:::io

    SHP["$$\begin{gathered}\text{本步是三种形状里的哪一种，在组表时就定下来}\\\\\text{prefill：输入整段 prompt 或一段 chunk，变长注意力，出口只取每序列最后 1 个位置}\\\\\text{decode：输入 1 个 token，单个 query 看全部历史，出口就这 1 个位置}\\\\\text{投机验证：输入 }K+1\text{ 个位置，出口 }【每个】\text{位置都要用}\\\\\text{它借的是 prefill 通道（要变长注意力），但语义与 chunked prefill 完全不同}\\\\\text{⚠ chunked prefill 喂的是真实 token；投机喂的是猜出来的 token}\\\\\text{走 CUDA Graph 的只有 decode（形状固定 + 补齐）；另外两种长度可变，不走}\\\\\text{账本推进也不同：prefill 推进整段、decode 推进 }1\text{、投机只推进 }j+1\\\\\text{回传元素数也不同：前两种每请求 1 个；投机是「定宽 }\times\text{ 请求数」}\end{gathered}$$"]:::io

    subgraph TPA["段 0 的 TP 组内通信（卡 0 ⇄ 卡 1）　两张卡各自发起同一条，没有主卡"]
        direction TB
        X0["$$\begin{gathered}\text{③ 集合通信 allreduce(SUM)：查表这一步就要一次}\\\\\text{卡 0 与卡 1 各自发起；越界 token 在别的卡上是零向量}\\\\h\,[N,hs]=\sum_{r=0}^{tp-1}h^{(r)}\end{gathered}$$"]:::comm
        X1["$$\begin{gathered}\text{层内第 1 次 · 集合通信 allreduce(SUM)}\\\\\text{卡 0 与卡 1 各自发起同一条（两层中间那个蓝框）}\\\\\text{为什么必须：输出投影按输入维切了，两卡各只有一半的和}\\\\y\,[N,hs]=y^{(0)}+y^{(1)}\qquad\text{算完两卡都拿到完整结果}\end{gathered}$$"]:::comm
        X2["$$\begin{gathered}\text{层内第 2 次 · 集合通信 allreduce(SUM)}\\\\\text{卡 0 与卡 1 各自发起同一条（两层中间那个蓝框）}\\\\\text{为什么必须：命中的专家分散在两卡上，各卡只算到一部分}\\\\m\,[N,hs]=m^{(0)}+m^{(1)}\qquad\text{稠密模型时求的是降维投影的输出}\end{gathered}$$"]:::comm
    end

    subgraph TPB["段 1 的 TP 组内通信（卡 2 ⇄ 卡 3）　与段 0 是同一套，只换了一对卡"]
        direction TB
        X5["$$\begin{gathered}\text{层内第 1 次 · 集合通信 allreduce(SUM)}\\\\\text{卡 2 与卡 3 各自发起同一条}\\\\y\,[N,hs]=y^{(0)}+y^{(1)}\end{gathered}$$"]:::comm
        X6["$$\begin{gathered}\text{层内第 2 次 · 集合通信 allreduce(SUM)}\\\\\text{卡 2 与卡 3 各自发起同一条}\\\\m\,[N,hs]=m^{(0)}+m^{(1)}\end{gathered}$$"]:::comm
    end

    X3["$$\begin{gathered}\text{交接⑤ PP 点对点下发（}【只有这一个方向】\text{，不经 CPU）}\\\\\text{卡 0}\to\text{卡 2：}h\,[N,hs]\ \text{与}\ r\,[N,hs]\\\\\text{卡 1}\to\text{卡 3：}h\,[N,hs]\ \text{与}\ r\,[N,hs]\\\\\text{两路各发各的，不是广播}\\\\\text{为什么是两项：残差是两条线，少送一项下一段就算错}\\\\\text{为什么不用 allgather：}hs\text{ 在 TP 组内根本没切，每卡本来就是完整的}\\\\\text{⚠ PP 没有反方向：段 1 算完不在点对点通道上回传激活值}\\\\\text{采样结果另走「交接②③」与「控制通道」回去（见下面的回程）}\end{gathered}$$"]:::comm

    subgraph C0["卡 0 · 段 0 · TP rank 0　（跑层 0–13；负责 Q 头 0–7、KV 头 0–3）"]
        direction TB
        C0a["$$\begin{gathered}\text{收到本步入参（四张卡同一批）}\\\\N\text{ 个 token；本段要跑 14 层（PP 把 28 层切成两段）}\end{gathered}$$"]
        C0b["$$\begin{gathered}\text{③ 查表得向量：词表并行，越界 token 取零向量，最后要一次求和}\\\\h\,[N,hs]=E\,[x],\qquad hs=1024,\ V=151936\end{gathered}$$"]
        C0c["$$\begin{gathered}\text{④-1 归一化①：作用在完整 }hs\text{ 上（没被切）}\Rightarrow\text{本步零通信}\\\\x\,[N,hs]=\mathrm{RMSNorm}_1(h)\odot\gamma_1=\frac{h}{\sqrt{\frac{1}{hs}\sum_i h_i^2+\epsilon}}\odot\gamma_1,\quad \epsilon=10^{-6}\end{gathered}$$"]
        C0d["$$\begin{gathered}\text{A1 三合一投影：列并行，按输出维切，本卡取前半段}\Rightarrow\text{零通信}\\\\q^{(0)}=x\,[N,hs]\cdot\big(W_q^{(0)}\big)^{\top},\qquad q^{(0)}\,[N,ahs/tp]=[N,1024]\end{gathered}$$"]
