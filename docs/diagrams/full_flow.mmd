        C0f["$$\begin{gathered}\text{A5 写本卡的 KV 缓存（只写自己那 4 个 KV 头，且必须先写）}\\\\k^{(0)}_{cache}[\text{slot}]=k^{(0)},\qquad v^{(0)}_{cache}[\text{slot}]=v^{(0)}\end{gathered}$$"]
        C0g["$$\begin{gathered}\text{A6–A9 注意力：本卡只算自己那 8 个 Q 头}\\\\o^{(0)}=\mathrm{softmax}\!\Big(\frac{q^{(0)}k^{(0)\top}}{\sqrt{d_h}}\Big)v^{(0)},\qquad o^{(0)}\,[N,1024]\end{gathered}$$"]
        C0h["$$\begin{gathered}\text{A10 输出投影：行并行，按输入维切}\Rightarrow\text{本卡只算出一个部分和}\\\\y^{(0)}=z^{(0)}\,[N,ahs/tp]\cdot\big(W_{out}^{(0)}\big)^{\top},\qquad y^{(0)}\,[N,hs]\end{gathered}$$"]
        C0i["$$\begin{gathered}\text{④-3 残差① + ④-4 归一化②（系数来自 postnorm 合并）}\\\\h'=\alpha_1 x+\beta_1 y,\qquad u\,[N,hs]=\mathrm{RMSNorm}_2(h')\odot\gamma_2\end{gathered}$$"]
        C0j["$$\begin{gathered}\text{B4 路由打分：路由权重每卡一份完整副本}\Rightarrow\text{与卡 1 选出同一批专家}\\\\s\,[N,E]=\mathrm{softmax}\big(u\cdot W_g^{\top}\big)\end{gathered}$$"]
        C0k["$$\begin{gathered}\text{B5–B7 本卡专家分片：只算中间维的 }1/tp\Rightarrow\text{又是部分和}\\\\m^{(0)}=\sum_{i\in\mathcal{T}}w_i\,W_{2,i}^{(0)}\Big[\mathrm{SiLU}\big(W_{1,i}^{(0)}u\big)\odot W_{3,i}^{(0)}u\Big]\end{gathered}$$"]
        C0l["$$\begin{gathered}\text{④-6 残差②：回 ④-1 做下一层（本段共 14 层）}\\\\h''=\alpha_2 u+\beta_2 m,\qquad h\coloneqq h''\end{gathered}$$"]
        C0m["$$\begin{gathered}\text{本段 14 层跑完：把 }h\text{ 与 }r\text{ 两项发给卡 2}\\\\h\,[N,hs]\ \text{与}\ r\,[N,hs],\qquad \text{peer}=\text{PP 组内下一个}\Rightarrow\text{卡 2}\end{gathered}$$"]
