        C3g["$$\begin{gathered}\text{④-3 残差① + ④-4 归一化②}\\\\h'=\alpha_1 x+\beta_1 y,\qquad u=\mathrm{RMSNorm}_2(h')\odot\gamma_2\end{gathered}$$"]
        C3h["$$\begin{gathered}\text{B4 路由打分（与卡 2 同一批专家）}\\\\s\,[N,E]=\mathrm{softmax}\big(u\cdot W_g^{\top}\big)\end{gathered}$$"]
        C3i["$$\begin{gathered}\text{B5–B7 本卡专家分片}\Rightarrow\text{部分和}\\\\m^{(1)}=\sum_{i\in\mathcal{T}}w_i\,W_{2,i}^{(1)}\Big[\mathrm{SiLU}\big(W_{1,i}^{(1)}u\big)\odot W_{3,i}^{(1)}u\Big]\end{gathered}$$"]
        C3j["$$\begin{gathered}\text{④-6 残差②：下一层（本段共 14 层）}\\\\h''=\alpha_2 u+\beta_2 m\end{gathered}$$"]
        C3k["$$\begin{gathered}\text{14 层跑完 → 末层归一化}\\\\H_n\,[N,hs]=\mathrm{RMSNorm}_{last}(H)\odot\gamma_n\end{gathered}$$"]
        C3l["$$\begin{gathered}\text{输出层（复制）}\Rightarrow\text{与卡 2 逐位相同的 logits}\\\\\mathrm{logits}\,[n,V]=H_n\,[N,hs]\cdot W_{lm}^{\top}\end{gathered}$$"]
        C3m["$$\begin{gathered}\text{本卡不采样 —— 采样只由末段的 TP rank 0（卡 2）做}\\\\\text{本卡算完就等下一轮}\end{gathered}$$"]
        C3a --> C3b --> C3c --> C3d --> C3e --> C3f
        C3f --> X5
        X5 --> C3g
        C3g --> C3h --> C3i
        C3i --> X6
        X6 --> C3j
        C3j --> C3k --> C3l --> C3m
    end

    subgraph RET["回程（GPU → CPU）：先异步拷回，再同步等，最后经控制通道送回 driver"]
        direction TB
        H2["$$\begin{gathered}\text{交接② 异步 D2H：采样结果从显存拷回 pinned 内存}\\\\\text{拷完立刻返回，CPU 不在这里等 —— 全流程唯一的异步优化}\\\\\text{目的：把「等 GPU」推迟到真正要用这个数据的时候}\\\\\text{⚠ 只有 driver 进程（rank 0）自己的采样结果能这样异步拿}\\\\\text{其它卡的结果仍在它们自己的进程里，得走下一条}\end{gathered}$$"]:::io
        H3["$$\begin{gathered}\text{交接③ 同步点：等到真正要用数据时才停下等}\\\\\text{全流程里 CPU 唯一真正阻塞在 GPU 上的地方}\\\\\text{在这之前 CPU 还能干别的（而这里的「别的」只是准备下一轮组表）}\end{gathered}$$"]:::io
        H4["$$\begin{gathered}\text{控制通道：采样卡}\to\text{driver（这条}【不是】\text{PP 点对点！）}\\\\\text{PP 点对点只有正向，送的是激活值；采样结果走的是另一条字节通道}\\\\\text{为什么另开一条：两边的载荷形状不固定（一次调度结果有几十个字段）}\\\\\text{而底层只能传张量 ⇒ 先序列化成字节、包成张量，到了再还原}\\\\\text{用 Gloo 不用 NCCL：消息在 CPU 上、又都很小}\\\\\text{协议上先传长度再传内容（长度 }0\text{ 表示没数据）}\\\\\text{⚠ driver 侧的收是}【阻塞】\text{的 ⇒ 这一步没法与下一次调度重叠，是硬停顿}\end{gathered}$$"]:::io
    end

    subgraph SP2["⑰ 投机解码 · 下半场（CPU · 卡 0）：判接受、重采样、只推进 j+1"]
        direction TB
        S4["$$\begin{gathered}\text{⑰-4 逐位置判接受：以概率 }\min\!\big(1,\ p/q\big)\text{ 接受，}q\text{ 必须来自草稿侧}\\\\\text{⚠ }q\text{ 绝不能取 target 自己的概率：那样 }q\equiv p\Rightarrow\min(1,p/q)\equiv1\\\\\text{⇒ 草稿被无条件接受、拒绝那半永不触发 ⇒ 分布被改掉，不再无损}\\\\\text{贪心 }T=0\text{ 时 }p\text{、}q\text{ 都退化成 one-hot}\\\\\text{⇒ 规则变成「草稿 token 是否等于 target 的 argmax」，实现上直接比 token 号}\\\\\text{接受 }j\text{ 个（}0\le j\le K\text{）；接受率 }\alpha=j/K\text{ 是收益的唯一自变量}\\\\\text{⚠ 引擎现在这条路用的是贪心判定；采样那一套有完整实现与单测但没接进来}\end{gathered}$$"]
        S5["$$\begin{gathered}\text{⑰-5 被拒的那个位置由 target 重采样，且必须从残差分布里采}\\\\p'(x)=\frac{\max\big(0,\ p(x)-q(x)\big)}{\sum_{x'}\max\big(0,\ p(x')-q(x')\big)}\\\\\text{两路合起来才等于 }p\text{：}\ \underbrace{\min(q,p)}_{\text{接受路}}\ +\ \underbrace{(p-q)^{+}}_{\text{拒绝路}}\ =\ p(x)\\\\\text{为什么必须砍掉草稿「过度自信」的那部分：不砍就变成有偏解码}\\\\\text{查表草稿是特例：}q\text{ 退化成 one-hot ⇒ 接受概率就是 }p(x̃)\text{，残差就是把这项拿掉再归一化}\end{gathered}$$"]
        S6["$$\begin{gathered}\text{⑰-6 账本只推进 }j+1\text{，不回滚}\\\\\text{有效产出 }j+1\text{ 个；已写进 KV 但无效的 }K-j\text{ 个槽不做任何事}\\\\\text{下一步的槽位映射从新的已缓存数起算，自然把它们覆盖掉}\\\\\text{为什么敢不回滚：块大小 }256\text{，而 }K+1\text{ 只有 }4\sim8\text{ ⇒ 几乎必在同一块内}\\\\\text{⚠ 发布前缀缓存时必须显式传 }j+1\text{：默认会传 }K+1\\\\\text{⇒ 块边界错位 ⇒ 后来的请求会命中与真实文本不符的前缀}\\\\\text{被拒的草稿 token 压根没进过序列，所以不进前缀索引是自然结果}\\\\\text{⚠ 与 TP 相冲：验证时激活值放大 }K+1\text{ 倍 ⇒ allreduce 消息也放大 }K+1\text{ 倍}\\\\\text{本机每步通信 }224\text{ KB}\to K=5\text{ 时 }1.34\text{ MB ⇒ 无 NVLink 可能互相拖累}\end{gathered}$$"]
    end

    subgraph UPD["收尾（CPU · 卡 0）：判结束、发布满块、抢占，然后回流或流出　（没开投机时也走这一段，只是上一步没有「判接受」）"]
        direction TB
        U1["$$\begin{gathered}\text{判结束：命中结束符 / 到长度上限 / 命中停止串 ⇒ 标成已完成}\\\\\text{⚠ 已完成的序列必须从运行集合里摘掉（漏了会一直空转）}\\\\\text{为什么容易漏：普通回写路径末尾那句收尾很不起眼，但它必须存在}\end{gathered}$$"]
        U2["$$\begin{gathered}\text{发布满块进前缀缓存：只发布已经填满的块}\\\\\text{半截块的内容下次还会变（再来一个 token 就写进去了）}\\\\\text{⇒ 进去会让别的请求命中错前缀；这是与投机无关的通用规则}\\\\\text{例：块大小 }256\text{ 时，一段 }128\text{ 个 token 的输出一个块都填不满 ⇒ 一个 token 都进不了缓存}\\\\\text{投机路径要按有效长度 }j+1\text{ 发布，不能按 }K+1\end{gathered}$$"]
        U3["$$\begin{gathered}\text{抢占：本仓库没有换出、只有重算}\\\\\text{前向要的显存不够时，挑序列释放它的块 ⇒ 下次它重新 prefill}\\\\\text{释放时}【不发布】\text{进前缀缓存（之前已发布的满块仍留着，回来还可能命中）}\\\\\text{⚠ 必须把这一路带来的草稿一起丢掉}\\\\\text{否则序列带着 decode 语义的草稿回到等待队列，重新 prefill 时对不上}\end{gathered}$$"]
        U4["$$\begin{gathered}\text{死循环保护：连续 }1024\text{ 步都调度不出东西、却还有没做完的请求}\\\\\text{⇒ 直接报错（几乎一定是 KV 池耗尽），而不是静静地空转}\end{gathered}$$"]
        U5["$$\begin{gathered}\text{回流：这一步的产出直接成为下一步的输入（形状 }S=1\text{）}\\\\\text{回 ① 再调度一轮 —— 这就是整张图的闭环}\\\\\text{顺带一提：CPU 的活与 GPU 的前向严格交替、并不重叠}\\\\\text{唯一的例外是交接② 那一步，它刻意做成异步}\\\\\text{但控制通道那一步是阻塞的，所以实际上还是有硬停顿}\end{gathered}$$"]
    end

    H6["$$\begin{gathered}\text{交接⑥ 流出：这一步的增量 token 交给前端，流式返回用户}\\\\\text{每步都发生（这是唯一的出口），与回流并行}\\\\\text{注意内容：流出的是}【这一步新多出来的】\text{那几个 token，不是整段重发}\\\\\text{投机时一次流出 }j+1\text{ 个 —— 用户看到的是「一次蹦出好几个字」}\end{gathered}$$"]:::io

